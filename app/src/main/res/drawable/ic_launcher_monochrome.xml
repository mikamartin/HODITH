<?xml version="1.0" encoding="utf-8"?>
<!-- Android 13+ themed icon layer: the system re-tints this from the device wallpaper, so
     only the silhouette (no fill/gradient/glint) matters here. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Same scale-down about the safe-zone center as ic_launcher_foreground.xml, so the themed
         icon matches the regular one's proportions. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.9"
        android:scaleY="0.9">
        <path
            android:pathData="M48,48m-19,0a19,19 0 1,0 38,0a19,19 0 1,0 -38,0"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="6.5" />
        <!-- Handle as an explicit filled shape, matching ic_launcher_foreground.xml's geometry:
             flat where it meets the ring (62,62), round only at the outer tip (79,79). -->
        <path
            android:pathData="M58.818,65.182L75.818,82.182A4.5,4.5 0 0,0 82.182,75.818L65.182,58.818Z"
            android:fillColor="#FFFFFF" />
    </group>
</vector>
