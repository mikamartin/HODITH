    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Same scale-down about the safe-zone center as ic_launcher_foreground.xml, so the themed
         icon matches the regular one's proportions. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.9"
        android:scaleY="0.9">
        <path
            android:pathData="M62,62L74,74"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="9"
            android:strokeLineCap="round" />
        <path
            android:pathData="M48,48m-19,0a19,19 0 1,0 38,0a19,19 0 1,0 -38,0"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="6.5" />
    </group>
</vector>
