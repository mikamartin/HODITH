<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground layer: 1b colorway's ink-teal glass lens + handle, centered in
     the 66dp safe zone. Also reused directly as the splash screen's animated icon (see
     Theme.Hodith.Splash in styles.xml) since both contexts want the same glyph at a similar
     scale. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Whole glyph scaled down about the safe-zone center (54,54) for more breathing room
         around it, rather than reworking every path's coordinates by hand. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.9"
        android:scaleY="0.9">
        <!-- Split into two paths (fill-only, then stroke-only) rather than one path combining a
             plain strokeColor with a nested aapt:attr gradient fillColor: that combination built
             and linted clean but rendered with the ring outline missing on a real device, even
             though the gradient fill itself was fine. Neither build tool validates on-device
             rendering. -->
        <path android:pathData="M48,48m-19,0a19,19 0 1,0 38,0a19,19 0 1,0 -38,0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="44"
                    android:centerY="42"
                    android:gradientRadius="18">
                    <item android:offset="0" android:color="#99FFFFFF" />
                    <item android:offset="0.6" android:color="#26FFFFFF" />
                    <item android:offset="1" android:color="#0AFFFFFF" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:pathData="M48,48m-19,0a19,19 0 1,0 38,0a19,19 0 1,0 -38,0"
            android:strokeWidth="6.5">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="29"
                    android:startY="29"
                    android:endX="67"
                    android:endY="67">
                    <item android:offset="0" android:color="#5A7A80" />
                    <item android:offset="1" android:color="#1E393F" />
                </gradient>
            </aapt:attr>
        </path>
        <group
            android:pivotX="41"
            android:pivotY="40"
            android:rotation="-35">
            <path
                android:pathData="M35.5,40a5.5,2.6 0 1,0 11,0a5.5,2.6 0 1,0 -11,0"
                android:fillColor="#FFFFFF"
                android:fillAlpha="0.7" />
        </group>
        <!-- Handle as an explicit filled shape rather than a stroked line: flat where it meets
             the ring (62,62), round only at the outer tip (79,79). android:strokeLineCap applies
             to both ends of a stroked path alike, so a flat-one-end/round-other-end capsule needs
             hand-built path data instead. Drawn last (on top of the ring) since it's meant to
             read as attached to it; both use the same opaque gradient so the overlap can't
             composite into a darker blend the way two translucent strokes used to. -->
        <path android:pathData="M58.818,65.182L75.818,82.182A4.5,4.5 0 0,0 82.182,75.818L65.182,58.818Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="58.818"
                    android:startY="58.818"
                    android:endX="82.182"
                    android:endY="82.182">
                    <item android:offset="0" android:color="#5A7A80" />
                    <item android:offset="1" android:color="#1E393F" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
